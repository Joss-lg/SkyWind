---

---

<section
    class="relative min-h-svh flex flex-col bg-noche overflow-hidden"
    aria-label="Inicio"
>
    <!-- Panel imagen derecho con recorte diagonal -->
    <div
        class="absolute inset-0 hero-image [clip-path:polygon(44%_0,100%_0,100%_100%,30%_100%)]"
        aria-hidden="true"
    >
        <img
            src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=1920,fit=crop/RbAChiWNk2mtBQkT/portada_facebook_sky-UGFFX5Ha3oivw5XY.png"
            alt=""
            class="w-full h-full object-cover object-[60%_center]"
            loading="eager"
            fetchpriority="high"
        />
        <div
            class="absolute inset-0 bg-linear-to-r from-noche via-noche/65 to-noche/15"
        >
        </div>
    </div>

    <!-- Turbina animada decorativa -->
    <div
        class="absolute left-[38%] top-1/2 -translate-y-1/2 w-[380px] h-[380px] opacity-[0.035] pointer-events-none select-none hidden lg:block"
        aria-hidden="true"
    >
        <svg viewBox="0 0 200 200" fill="white" class="w-full h-full">
            <circle cx="100" cy="100" r="6"></circle>
            <g style="transform-origin:100px 100px" class="animate-spin-blade">
                <path d="M100 94L95 30Q93 8 100 8Q107 8 105 30Z" opacity=".95"
                ></path>
            </g>
            <g style="transform-origin:100px 100px" class="animate-spin-blade2">
                <path
                    d="M100 106L162 152Q178 165 172 174Q166 183 154 172Z"
                    opacity=".75"></path>
            </g>
            <g style="transform-origin:100px 100px" class="animate-spin-blade3">
                <path
                    d="M100 106L38 152Q22 165 28 174Q34 183 46 172Z"
                    opacity=".55"></path>
            </g>
        </svg>
    </div>

    <!-- Ghost text decorativo -->
    <p
        class="absolute right-[-0.04em] bottom-[-0.08em] text-[clamp(6rem,18vw,20rem)] font-extrabold leading-none tracking-tighter text-transparent [-webkit-text-stroke:1px_rgba(255,255,255,0.04)] pointer-events-none select-none z-0 hero-image"
        aria-hidden="true"
    >
        SKYWIND
    </p>

    <!-- Contenido -->
    <div
        class="relative z-10 flex-1 flex items-center px-6 max-w-container mx-auto w-full pt-40 pb-24"
    >
        <div class="max-w-[600px]">
            <!-- Badge -->
            <div class="hero-badge inline-flex items-center gap-2.5 mb-8">
                <span
                    class="flex items-center gap-2 bg-viento/10 border border-viento/30 text-viento text-sm font-semibold px-3.5 py-1.5 rounded-full"
                >
                    <span
                        class="w-[6px] h-[6px] rounded-full bg-viento animate-pulse-dot shrink-0"
                    ></span>
                    Energía renovable en México
                </span>
            </div>

            <h1
                class="hero-h1 text-[clamp(2.75rem,7vw,6rem)] font-extrabold leading-[1.02] tracking-[-0.035em] text-white mb-6 text-balance"
            >
                Construimos<br />la energía<br />
                <span class="text-cielo">del mañana</span>
            </h1>

            <p
                class="hero-body text-lg text-niebla leading-[1.7] max-w-[48ch] mb-10"
            >
                Desde 2022, realizamos obras y servicios de construcción y
                mantenimiento en proyectos eólicos, solares, hidroeléctricos y
                de obra civil para el sector público y privado.
            </p>

            <div class="hero-actions flex flex-wrap gap-3.5">
                <a
                    href="/servicio"
                    class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-cielo text-white font-semibold hover:bg-blue-700 transition-all hover:-translate-y-px shadow-[0_0_24px_rgba(23,98,212,0.4)]"
                >
                    Ver servicios
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 16 16"
                        fill="none"
                        aria-hidden="true"
                        ><path
                            d="M3 8h10M9 4l4 4-4 4"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                    >
                </a>
                <a
                    href="/acerca-de-skywind"
                    class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md text-white border border-white/30 hover:border-white/60 hover:bg-white/8 transition-all"
                >
                    Quiénes somos
                </a>
            </div>
        </div>
    </div>

    <!-- Stats bar -->
    <div
        class="hero-stats relative z-10 bg-oceano/95 backdrop-blur-md border-t border-borde"
    >
        <div
            class="max-w-container mx-auto px-6 py-5 flex items-center overflow-x-auto scrollbar-none gap-0"
        >
            {
                [
                    { value: "2022", label: "Año de fundación" },
                    { value: "4", label: "Especialidades" },
                    { value: "Eólica · Solar", label: "Hídrica · Civil" },
                    {
                        value: "Público y privado",
                        label: "Sector de proyectos",
                    },
                ].map((s, i) => (
                    <>
                        {i > 0 && (
                            <div
                                class="w-px h-9 bg-borde shrink-0 mx-7"
                                aria-hidden="true"
                            />
                        )}
                        <div class="flex flex-col gap-0.5 flex-1 min-w-[120px] shrink-0">
                            <span class="text-[1.375rem] font-bold text-white leading-none tracking-tight">
                                {s.value}
                            </span>
                            <span class="text-xs text-niebla">{s.label}</span>
                        </div>
                    </>
                ))
            }
        </div>
    </div>
</section>
