---
const services = [
    {
        href: "/eolica",
        color: "#1762D4",
        textColor: "text-cielo",
        label: "Energía Eólica",
        desc: "Construcción y mantenimiento de parques eólicos. Inspección de palas, montaje de aerogeneradores, obra civil y electromecánica.",
        icon: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="3" fill="currentColor"/><path d="M24 21L20 8Q19 4 24 4Q29 4 28 8Z" fill="currentColor" opacity=".9"/><path d="M24 27L35 38Q38 41 34 44Q30 47 29 43Z" fill="currentColor" opacity=".7"/><path d="M24 27L11 34Q7 36 6 31Q5 26 9 27Z" fill="currentColor" opacity=".5"/></svg>`,
    },
    {
        href: "/energia-solar",
        color: "#C97C00",
        textColor: "text-amber-600",
        label: "Energía Solar",
        desc: "Instalación de sistemas fotovoltaicos a escala industrial. Montaje de paneles, inversores y sistemas de gestión de energía.",
        icon: `<svg viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="7" fill="currentColor"/><line x1="24" y1="4" x2="24" y2="10" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="24" y1="38" x2="24" y2="44" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="4" y1="24" x2="10" y2="24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="38" y1="24" x2="44" y2="24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="9.4" y1="9.4" x2="13.7" y2="13.7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="34.3" y1="34.3" x2="38.6" y2="38.6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="38.6" y1="9.4" x2="34.3" y2="13.7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="13.7" y1="34.3" x2="9.4" y2="38.6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`,
    },
    {
        href: "/energia-hidroelectrica",
        color: "#0CBF82",
        textColor: "text-viento",
        label: "Energía Hidroeléctrica",
        desc: "Obras civiles y electromecánicas en centrales hidroeléctricas. Mantenimiento de turbinas, compuertas y sistemas de control.",
        icon: `<svg viewBox="0 0 48 48" fill="none"><path d="M24 6C24 6 12 18 12 27C12 34.2 17.4 40 24 40C30.6 40 36 34.2 36 27C36 18 24 6 24 6Z" fill="currentColor" opacity=".85"/><path d="M24 26C24 26 18 31 18 35C18 38.3 20.7 41 24 41C27.3 41 30 38.3 30 35C30 31 24 26 24 26Z" fill="currentColor"/></svg>`,
    },
    {
        href: "/obra-civil",
        color: "#5B7EC9",
        textColor: "text-[#5B7EC9]",
        label: "Obra Civil",
        desc: "Terracerías, caminos de acceso, plataformas de montaje, drenaje pluvial y edificaciones auxiliares para proyectos renovables.",
        icon: `<svg viewBox="0 0 48 48" fill="none"><rect x="8" y="28" width="32" height="14" rx="1" fill="currentColor" opacity=".5"/><rect x="14" y="20" width="8" height="22" rx="1" fill="currentColor" opacity=".8"/><rect x="26" y="14" width="8" height="28" rx="1" fill="currentColor"/><rect x="6" y="40" width="36" height="3" rx="1" fill="currentColor" opacity=".4"/></svg>`,
    },
];
---

<section
    id="servicios"
    class="py-[clamp(5rem,10vw,9rem)] bg-alba"
    aria-labelledby="services-heading"
>
    <div class="max-w-container mx-auto px-6">
        <header class="grid grid-cols-1 md:grid-cols-2 gap-6 items-end mb-14">
            <h2
                id="services-heading"
                data-reveal
                class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-[-0.03em] leading-[1.05] text-noche"
            >
                Especialidades
            </h2>
            <p
                data-reveal
                data-delay="2"
                class="text-[1.0625rem] text-[#4A6480] leading-[1.65] max-w-[42ch]"
            >
                Cubrimos el ciclo completo — desde la construcción hasta el
                mantenimiento — en cuatro sectores de energía renovable.
            </p>
        </header>

        <ul
            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 divide-x divide-y divide-[#D5E2F0] border border-[#D5E2F0] rounded-xl overflow-hidden"
            role="list"
        >
            {
                services.map((s, i) => (
                    <li class="bg-white" data-reveal data-delay={String(i + 1)}>
                        <a
                            href={s.href}
                            class="group flex flex-col gap-5 p-8 h-full border-l-[3px] border-transparent hover:border-current transition-all duration-300"
                            style={`--tw-border-opacity:1; border-color: transparent`}
                            onmouseenter={`this.style.borderColor='${s.color}'`}
                            onmouseleave={`this.style.borderColor='transparent'`}
                        >
                            <div
                                class={`w-10 h-10 ${s.textColor} transition-transform duration-300 group-hover:scale-110`}
                                set:html={s.icon}
                            />
                            <div class="flex-1">
                                <h3
                                    class="text-xl font-bold text-noche tracking-tight leading-snug mb-2.5 group-hover:text-[var(--accent)] transition-colors"
                                    style={`--accent: ${s.color}`}
                                >
                                    {s.label}
                                </h3>
                                <p class="text-sm text-[#4A6480] leading-[1.65]">
                                    {s.desc}
                                </p>
                            </div>
                            <span
                                class={`${s.textColor} opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300 self-end`}
                                aria-hidden="true"
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 20 20"
                                    fill="none"
                                >
                                    <path
                                        d="M4 10H16M16 10L11 5M16 10L11 15"
                                        stroke="currentColor"
                                        stroke-width="1.75"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                </svg>
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
