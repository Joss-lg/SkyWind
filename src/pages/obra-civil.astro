---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const trabajos = [
    {
        titulo: "Terracerías y movimiento de tierras",
        desc: "Desmonte, despalme, cortes y rellenos para adecuación del terreno donde se construirá el proyecto.",
    },
    {
        titulo: "Caminos de acceso",
        desc: "Apertura y mejoramiento de caminos para acceso a las áreas de trabajo y vialidades internas del parque.",
    },
    {
        titulo: "Plataformas de montaje",
        desc: "Preparación de plataformas para grúas, posicionamiento de aerogeneradores o estructuras solares.",
    },
    {
        titulo: "Drenaje pluvial",
        desc: "Sistemas de canales, cunetas, alcantarillas y estructuras de control de escurrimientos.",
    },
    {
        titulo: "Cercados y señalización",
        desc: "Instalación de cercos perimetrales, portones de acceso y señalización de seguridad.",
    },
    {
        titulo: "Obras de contención",
        desc: "Muros de contención, taludes estabilizados y obras de protección contra erosión.",
    },
    {
        titulo: "Edificaciones auxiliares",
        desc: "Casetas de control, bodegas, subestaciones y otras estructuras de soporte del proyecto.",
    },
    {
        titulo: "Obras de urbanización",
        desc: "Banquetas, estacionamientos, iluminación exterior y jardinería dentro del área del proyecto.",
    },
];
---

<Layout
    title="Obra Civil — Skywind México"
    description="Infraestructura civil para proyectos de energía renovable: terracerías, caminos, plataformas, drenaje y edificaciones auxiliares."
>
    <Nav />

    <section class="bg-noche pt-40 pb-28 relative overflow-hidden">
        <div
            class="absolute inset-0 bg-[radial-gradient(ellipse_at_45%_55%,rgba(12,191,130,0.12),transparent_60%)]"
            aria-hidden="true"
        >
        </div>
        <div
            class="max-w-container mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-end"
        >
            <div>
                <a
                    href="/servicio"
                    class="inline-flex items-center gap-1.5 text-niebla text-sm mb-6 hover:text-white transition-colors"
                >
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none"
                        ><path
                            d="M13 8H3M7 4l-4 4 4 4"
                            stroke="currentColor"
                            stroke-width="1.75"
                            stroke-linecap="round"
                            stroke-linejoin="round"></path></svg
                    >
                    Todos los servicios
                </a>
                <p
                    class="hero-badge text-viento text-sm font-medium tracking-wide mb-3"
                >
                    Servicio especializado
                </p>
                <h1
                    class="hero-h1 text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold tracking-[-0.035em] leading-[1.03] text-white mb-5 text-balance"
                >
                    Obra Civil
                </h1>
                <p
                    class="hero-body text-niebla text-lg leading-[1.7] max-w-[48ch] mb-8"
                >
                    La infraestructura civil es la base de cualquier proyecto de
                    energía renovable. Ejecutamos todas las obras previas y
                    complementarias que hacen posible la instalación de los
                    equipos de generación.
                </p>
                <a
                    href="/contacto"
                    class="inline-flex items-center gap-2 px-7 py-3.5 rounded-md bg-viento text-noche font-bold hover:bg-[#09A870] transition-colors"
                >
                    Solicitar información
                </a>
            </div>

            <blockquote class="border-l-2 border-viento pl-6">
                <p class="text-white/80 text-lg leading-[1.7] italic">
                    "Sin una obra civil sólida, ningún proyecto de energía
                    renovable puede operar con seguridad y eficiencia a largo
                    plazo."
                </p>
                <footer class="mt-4 text-niebla text-sm">
                    Equipo técnico de Skywind México
                </footer>
            </blockquote>
        </div>
    </section>

    <main>
        <section class="py-[clamp(5rem,10vw,9rem)] bg-alba">
            <div class="max-w-container mx-auto px-6">
                <header class="mb-14 max-w-2xl" data-reveal>
                    <p
                        class="text-viento text-sm font-medium tracking-wide mb-4"
                    >
                        Lo que hacemos
                    </p>
                    <h2
                        class="text-[clamp(2rem,4vw,3rem)] font-extrabold tracking-[-0.03em] leading-[1.05] text-noche"
                    >
                        Alcance de obra civil
                    </h2>
                </header>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-[#D5E2F0] border border-[#D5E2F0] rounded-xl overflow-hidden"
                >
                    {
                        trabajos.map((t, i) => (
                            <div
                                data-reveal
                                data-delay={String((i % 4) + 1)}
                                class="bg-white p-7 flex flex-col gap-3"
                            >
                                <div class="w-8 h-1 rounded-full bg-viento" />
                                <h3 class="text-noche font-bold text-sm leading-snug">
                                    {t.titulo}
                                </h3>
                                <p class="text-[#4A6480] text-xs leading-[1.65]">
                                    {t.desc}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Por qué importa la obra civil -->
        <section class="py-[clamp(5rem,10vw,9rem)] bg-noche">
            <div
                class="max-w-container mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
            >
                <div>
                    <p
                        class="text-viento text-sm font-medium tracking-wide mb-4"
                    >
                        Nuestra perspectiva
                    </p>
                    <h2
                        class="text-[clamp(1.875rem,3.5vw,2.75rem)] font-extrabold tracking-tight leading-[1.1] text-white mb-6"
                    >
                        La obra civil como fundamento del proyecto
                    </h2>
                    <p class="text-niebla leading-[1.75] text-lg mb-5">
                        Una deficiente preparación del terreno compromete la
                        operación de los equipos, eleva los costos de
                        mantenimiento y reduce la vida útil del proyecto.
                    </p>
                    <p class="text-niebla leading-[1.75]">
                        En Skywind ejecutamos la obra civil con los mismos
                        estándares que aplicamos a la obra electromecánica:
                        planeación rigurosa, materiales de calidad y supervisión
                        técnica permanente en campo.
                    </p>
                </div>
                <div
                    class="grid grid-cols-2 gap-px bg-borde border border-borde rounded-xl overflow-hidden"
                >
                    {
                        [
                            {
                                t: "Topografía",
                                d: "Levantamiento y trazo previo a cada intervención.",
                                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M3 21h18M9 21V7l-6 3.5M15 21V7l6 3.5M9 7V3M15 7V3M9 3h6M3 10.5l6-3.5M15 7l6 3.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                            },
                            {
                                t: "Maquinaria",
                                d: "Equipo propio y subcontratado de alta capacidad.",
                                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0v-4a1 1 0 011-1h2a1 1 0 011 1v4m-4 0h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                            },
                            {
                                t: "Control de calidad",
                                d: "Pruebas de compactación y verificación de especificaciones.",
                                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                            },
                            {
                                t: "Seguridad en obra",
                                d: "Protocolos HSE aplicados en cada frente de trabajo.",
                                icon: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
                            },
                        ].map((c) => (
                            <div class="bg-oceano p-7 flex flex-col gap-3">
                                <span class="text-viento" set:html={c.icon} />
                                <h3 class="text-white font-bold text-sm">
                                    {c.t}
                                </h3>
                                <p class="text-niebla text-xs leading-[1.6]">
                                    {c.d}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="bg-viento py-20">
            <div
                class="max-w-container mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-8"
            >
                <div>
                    <h2
                        class="text-[clamp(1.5rem,3vw,2.25rem)] font-extrabold tracking-tight text-noche mb-2"
                    >
                        ¿Requieres obra civil para tu proyecto?
                    </h2>
                    <p class="text-noche/65">
                        Cuéntanos y te damos presupuesto sin costo.
                    </p>
                </div>
                <a
                    href="/contacto"
                    class="shrink-0 px-7 py-3.5 rounded-md bg-noche text-white font-bold hover:bg-oceano transition-colors"
                >
                    Iniciar conversación
                </a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>
